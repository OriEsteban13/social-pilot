# ── Base de datos ────────────────────────────────────────────────────────
# PostgreSQL vía Supabase (tanto en desarrollo como en producción). Usa la
# connection string del "Transaction pooler" (puerto 6543, recomendado para
# entornos serverless) — Project Settings → Database → Connection string en
# el panel de Supabase. El "aws-N-" del host varía según el nodo asignado a
# tu proyecto; cópialo tal cual, no lo asumas fijo en "aws-0-".
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-N-<region>.pooler.supabase.com:6543/postgres"
# `prisma db push` / `prisma db seed` (operaciones DDL o de escritura masiva)
# van más rápido y de forma más fiable por el "Session pooler" (mismo host,
# puerto 5432) — si `db push` se queda colgado por el puerto 6543, reintenta
# así: DATABASE_URL="...:5432/postgres" npx prisma db push

# ── Autenticación ────────────────────────────────────────────────────────
# Firma de la sesión "demo auth" local. Pendiente de migrar a Supabase Auth
# (ver ARCHITECTURE.md, sección Seguridad) — no urgente mientras el acceso
# esté limitado al propio equipo.
SESSION_SECRET="change-me-in-production"

# Supabase Storage — necesario para que las imágenes generadas con IA tengan
# URL pública real (OpenAIImageProvider/gpt-image-1 solo devuelve base64;
# sin esto, se guarda como data: URI, incompatible con SOCIAL_PROVIDER=metricool).
# Requiere crear a mano un bucket público en el panel de Supabase
# (Storage → New bucket → Public) — el nombre debe coincidir EXACTAMENTE con
# SUPABASE_STORAGE_BUCKET (los nombres de bucket son sensibles a mayúsculas).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="media" # opcional — debe coincidir con el nombre real del bucket

# ── Cifrado de tokens de integración ────────────────────────────────────
TOKEN_ENCRYPTION_KEY="change-me-in-production"

# ── IA ───────────────────────────────────────────────────────────────────
# mock: plantillas, sin llamadas externas (por defecto).
# anthropic: Claude real — requiere ANTHROPIC_API_KEY. Mejor calidad de
# redacción y traducción entre idiomas; recomendado para producción.
# groq: inferencia muy rápida/barata sobre modelos open-weight de terceros
# (Kimi K2, GPT-OSS, Llama...) — requiere GROQ_API_KEY. Calidad de redacción
# algo por debajo de Claude; revisa el contenido generado con más atención,
# sobre todo al principio.
AI_PROVIDER="mock" # mock | anthropic | groq
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8" # opcional; por defecto claude-opus-4-8
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile" # opcional; modelo de propósito general disponible en cualquier cuenta

# ── Generación de imagen / vídeo ────────────────────────────────────────
# mock: SVG con los colores de marca, sin llamadas externas (por defecto).
# openai: gpt-image-1 real — requiere OPENAI_API_KEY. Devuelve la imagen en
# base64; con SOCIAL_PROVIDER=metricool necesita Supabase Storage configurado
# arriba para producir una URL pública (si no, la publicación falla).
# fal: Flux (imagen) vía fal.ai — requiere FAL_KEY. Devuelve una URL pública
# real directamente, compatible con Metricool sin pasos adicionales.
# Independiente de AI_PROVIDER, ya que ni Anthropic ni fal.ai hacen ambas cosas a la vez.
IMAGE_PROVIDER="mock" # mock | openai | fal
OPENAI_API_KEY=""

# mock: solo guion/storyboard, sin archivo de vídeo real (por defecto).
# fal: vídeo real vía fal.ai — requiere FAL_KEY. Modelo configurable con
# FAL_VIDEO_MODEL (kling: mejor calidad, ~0.07$/s — o wan: más barato,
# ~0.05$/s a 480p). Ver INTEGRATIONS.md — la llamada es síncrona (espera a
# que el vídeo termine de generarse) y puede tardar más que una petición
# HTTP normal.
VIDEO_PROVIDER="mock" # mock | fal
FAL_KEY=""
FAL_IMAGE_MODEL="fal-ai/recraft/v3/text-to-image" # opcional; por defecto Recraft (mejor con texto/colores de marca que Flux)
FAL_VIDEO_MODEL="kling" # kling | wan

# ── Redes sociales (ver INTEGRATIONS.md) ────────────────────────────────
# simulated: SimulatedAdapter, sin llamadas externas (por defecto).
# metricool: MetricoolAdapter — una única integración real para las 5 redes
# vía la API de Metricool (plan Advanced o superior, obligatorio para tener
# acceso a la API). Cada empresa/workspace necesita su propio Brand ID de
# Metricool (blogId), configurable en Configuración → Metricool.
SOCIAL_PROVIDER="simulated" # simulated | metricool
METRICOOL_USER_TOKEN=""
METRICOOL_USER_ID=""
METRICOOL_TIMEZONE="Europe/Madrid" # opcional; zona horaria usada al programar publicaciones

# Adaptadores nativos directos (LinkedIn, Meta, TikTok, X) — no implementados
# todavía; documentados en INTEGRATIONS.md como alternativa futura si
# Metricool se queda corto para alguna plataforma en concreto.

# ── Cron ─────────────────────────────────────────────────────────────────
CRON_SECRET=""
